# Copy this file to .env and fill in real values. Never commit .env.

# --- backend ---
JWT_SECRET=change-me-to-a-long-random-string
MONGO_URI=mongodb://database:27017
MONGO_DB=mindguard

# If unset, the ai module falls back to a keyword-based scorer so the
# app still runs end to end without a key.
ANTHROPIC_API_KEY=
# Optional override (default claude-sonnet-5-5)
ANTHROPIC_MODEL=

# If unset, the notifications module runs in dry-run mode (logs instead
# of sending real SMS).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
COUNSELOR_PHONE_NUMBER=

# If unset, the music module falls back to a plain Spotify search link
# instead of an embedded playlist.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Comma-separated frontend origins allowed by CORS (no trailing slash). Default "*".
# Production: ALLOWED_ORIGINS=https://your-app.vercel.app
ALLOWED_ORIGINS=*

# --- frontend (set in Vercel; baked in at build time) ---
# Production: VITE_API_BASE=https://your-api.onrender.com
VITE_API_BASE=http://localhost:8000

# --- presentation ---
# 1 (default): seeds counselor/admin logins, a mock cohort and two demo personas on
# startup and exposes /api/demo/*. Set 0 for any real deployment.
DEMO_MODE=1
