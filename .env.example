# Copy this file to .env and fill in real values. Never commit .env.

# --- backend ---
JWT_SECRET=change-me-to-a-long-random-string
MONGO_URI=mongodb://database:27017
MONGO_DB=mindguard

# Groq API key (https://console.groq.com/keys) powers the AI companion chat and
# the LLM text analysis. If unset, check-ins fall back to the offline keyword
# scorer and the companion tells the student it isn't configured (no canned replies).
GROQ_API_KEY=
# Optional overrides (defaults shown). The fallback model is tried if the primary fails.
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# If unset, the notifications module runs in dry-run mode (logs instead
# of sending real SMS).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
COUNSELOR_PHONE_NUMBER=

# Counselor dashboard login, created/refreshed on every backend start (any mode).
# Demo defaults (also pre-filled on the sign-in screen). Change both for a real deployment.
COUNSELOR_EMAIL=counselor@mindguard.ai
COUNSELOR_PASSWORD=Counselor@123
COUNSELOR_NAME=Campus Counselor

# If unset, the music module falls back to a plain Spotify search link
# instead of an embedded playlist.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Comma-separated frontend origins allowed by CORS (no trailing slash). Default "*".
# Production: ALLOWED_ORIGINS=https://your-app.vercel.app
ALLOWED_ORIGINS=*

# --- frontend (set in Vercel; baked in at build time) ---
# Production: VITE_API_BASE=https://your-api.onrender.com
VITE_API_BASE=http://localhost:8000
# Demo only: pre-fills the Counselor sign-in tab. Set VITE_COUNSELOR_PASSWORD to empty in production.
VITE_COUNSELOR_EMAIL=counselor@mindguard.ai
VITE_COUNSELOR_PASSWORD=Counselor@123

# --- presentation ---
# 1 (default): seeds counselor/admin logins, a mock cohort and two demo personas on
# startup and exposes /api/demo/*. Set 0 for any real deployment.
DEMO_MODE=1
